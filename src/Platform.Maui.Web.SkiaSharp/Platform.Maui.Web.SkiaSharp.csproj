<!-- The Razor SDK is used only for its static web asset pipeline, which ships wwwroot/maui-web-skiasharp.js
     to consumers under _content/Platform.Maui.Web.SkiaSharp/. No Razor components or Blazor are involved. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Microsoft.Maui.Platform.Web.Skia</RootNamespace>
        <PackageId>Platform.Maui.Web.SkiaSharp</PackageId>
        <PackageVersion>$(WebPackageVersion)</PackageVersion>
        <!-- Not published to NuGet yet: built only as part of SampleWeb. -->
        <IsPackable>false</IsPackable>
        <Description>SkiaSharp for Platform.Maui.Web: the SkiaSharp.Views.Maui SKCanvasView rendered by Skia on WebAssembly into an HTML canvas, and Skia-backed MAUI image loading and bitmap export.</Description>
        <PackageTags>$(PackageTags) web wasm webassembly browser skia skiasharp canvas</PackageTags>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsTrimmable>true</IsTrimmable>
        <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="$(SkiaSharpVersion)" />
        <!-- SkiaImageLoadingService and SkiaBitmapExportContext, registered as MAUI's image services. -->
        <PackageReference Include="Microsoft.Maui.Graphics.Skia" Version="$(MauiVersion)" />
        <!-- libSkiaSharp.a, linked into the app's dotnet.native.wasm. Its buildTransitive targets turn on
             WasmBuildNative in the consuming app, which needs the wasm-tools workload. -->
        <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="$(SkiaSharpVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Platform.Maui.Web\Platform.Maui.Web.csproj" />
    </ItemGroup>

    <!-- Same as Platform.Maui.Web: keep this library's dev-server manifests out of referencing apps. -->
    <Target Name="_MauiWebKeepDevManifestsOutOfReferencers" AfterTargets="AddStaticWebAssetEndpointsBuildManifest">
        <ItemGroup>
            <ContentWithTargetPath Remove="$(StaticWebAssetDevelopmentManifestPath);$(StaticWebAssetEndpointsBuildManifestPath)" />
        </ItemGroup>
    </Target>

</Project>
