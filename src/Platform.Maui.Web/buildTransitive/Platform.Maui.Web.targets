<Project>

  <!--
    Everything lives in this one .targets file: the static web assets SDK generates its own
    Platform.Maui.Web.props in the package, so a props file of ours would be dropped when packing.
    Being a .targets file also means the app's own EnableDefaultMauiResourceItems is respected.
  -->
  <ItemGroup>
    <AvailableItemName Include="MauiAsset" />
    <AvailableItemName Include="MauiImage" />
    <AvailableItemName Include="MauiIcon" />
    <AvailableItemName Include="MauiFont" />
    <AvailableItemName Include="MauiSplashScreen" />
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);WEB;BROWSER</DefineConstants>
    <EnableDefaultMauiResourceItems Condition="'$(EnableDefaultMauiResourceItems)' == ''">true</EnableDefaultMauiResourceItems>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableDefaultMauiResourceItems)' == 'true'">
    <MauiImage Include="Resources\Images\**\*" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <MauiFont Include="Resources\Fonts\**\*" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <MauiAsset Include="Resources\Raw\**\*" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)">
      <LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </MauiAsset>
  </ItemGroup>

  <!-- App identity read by WebAppInfo. -->
  <ItemGroup>
    <AssemblyMetadata Include="MauiApplicationId" Value="$(ApplicationId)" Condition="'$(ApplicationId)' != ''" />
    <AssemblyMetadata Include="MauiApplicationTitle" Value="$(ApplicationTitle)" Condition="'$(ApplicationTitle)' != ''" />
    <AssemblyMetadata Include="MauiApplicationDisplayVersion" Value="$(ApplicationDisplayVersion)" Condition="'$(ApplicationDisplayVersion)' != ''" />
    <AssemblyMetadata Include="MauiApplicationVersion" Value="$(ApplicationVersion)" Condition="'$(ApplicationVersion)' != ''" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableDefaultMauiResourceItems)' == 'true' and '@(MauiIcon)' == ''">
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Condition="Exists('Resources\AppIcon\appicon.svg')" />
    <MauiIcon Include="Resources\AppIcon\appicon.png" Condition="!Exists('Resources\AppIcon\appicon.svg') and Exists('Resources\AppIcon\appicon.png')" />
  </ItemGroup>

  <!-- A WebAssembly app only runs in the browser; saying so keeps the platform analyzer quiet. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and '$(OutputType)' == 'Exe'">
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>browser</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The name each MauiImage is served under. As in MAUI's resizetizer, a Link names the image
    (<MauiImage Include="Resources\splashfg.svg" Link="Resources\Images\splash_logo.svg" /> is
    "splash_logo"); the file keeps its own extension, since SVGs are deployed as SVG.
  -->
  <Target Name="_MauiWebImageNames">
    <ItemGroup>
      <_MauiWebImage Remove="@(_MauiWebImage)" />
      <_MauiWebImage Include="@(MauiImage)">
        <MauiWebName Condition="'%(MauiImage.Link)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension('%(MauiImage.Link)'))</MauiWebName>
        <MauiWebName Condition="'%(MauiImage.Link)' == ''">%(MauiImage.Filename)</MauiWebName>
      </_MauiWebImage>
    </ItemGroup>
  </Target>

  <!--
    SVG MauiImages are deployed as SVG (browsers render them natively) and listed in assembly
    metadata so "name.png" references resolve to "name.svg" at runtime.
  -->
  <Target Name="_MauiWebVectorImageMetadata" BeforeTargets="AssignTargetPaths" DependsOnTargets="_MauiWebImageNames">
    <ItemGroup>
      <AssemblyMetadata Include="MauiWebVectorImage" Value="%(_MauiWebImage.MauiWebName)" Condition="'%(_MauiWebImage.Extension)' == '.svg'" />
    </ItemGroup>
  </Target>

  <!--
    MAUI resources are served from the app's root, next to index.html, as static web assets.
    They are staged under obj/ at their final paths and registered with that folder as their
    content root, so the dev server (dotnet run) and publish both find the real files. Linking them
    as wwwroot Content instead makes the SDK assume they live in wwwroot/, and the dev server then
    answers with empty files.
  -->
  <Target Name="_MauiWebStaticWebAssets" AfterTargets="ResolveProjectStaticWebAssets" DependsOnTargets="_MauiWebImageNames" Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' == 'true'">
    <PropertyGroup>
      <_MauiWebStagingDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'mauiweb'))</_MauiWebStagingDir>
    </PropertyGroup>

    <ItemGroup>
      <_MauiWebResource Include="@(_MauiWebImage)">
        <MauiWebPath>%(_MauiWebImage.MauiWebName)%(_MauiWebImage.Extension)</MauiWebPath>
      </_MauiWebResource>
      <_MauiWebResource Include="@(MauiFont)">
        <MauiWebPath>%(Filename)%(Extension)</MauiWebPath>
      </_MauiWebResource>
      <_MauiWebResource Include="@(MauiAsset)">
        <MauiWebPath Condition="'%(MauiAsset.LogicalName)' != ''">%(MauiAsset.LogicalName)</MauiWebPath>
        <MauiWebPath Condition="'%(MauiAsset.LogicalName)' == ''">%(MauiAsset.RecursiveDir)%(MauiAsset.Filename)%(MauiAsset.Extension)</MauiWebPath>
      </_MauiWebResource>
      <_MauiWebResource Include="@(MauiIcon)">
        <MauiWebPath>favicon%(Extension)</MauiWebPath>
      </_MauiWebResource>
    </ItemGroup>

    <Copy SourceFiles="@(_MauiWebResource)" DestinationFiles="@(_MauiWebResource->'$(_MauiWebStagingDir)%(MauiWebPath)')" SkipUnchangedFiles="true" Condition="'@(_MauiWebResource)' != ''">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>

    <ItemGroup>
      <_MauiWebStaged Include="@(_MauiWebResource->'$(_MauiWebStagingDir)%(MauiWebPath)')">
        <RelativePath>$([System.String]::Copy('%(_MauiWebResource.MauiWebPath)').Replace('\', '/'))</RelativePath>
        <ContentRoot>$(_MauiWebStagingDir)</ContentRoot>
      </_MauiWebStaged>
      <FileWrites Include="@(_MauiWebStaged)" />
    </ItemGroup>

    <DefineStaticWebAssets CandidateAssets="@(_MauiWebStaged)" SourceType="Discovered" SourceId="$(PackageId)"
                           ContentRoot="$(_MauiWebStagingDir)" BasePath="$(StaticWebAssetBasePath)" Condition="'@(_MauiWebStaged)' != ''">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_MauiWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints CandidateAssets="@(_MauiWebAsset)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)" Condition="'@(_MauiWebAsset)' != ''">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

  <!--
    Incremental builds otherwise serve a stale _framework/dotnet.js.gz (and other computed assets' .gz)
    from `dotnet run`, so the app asks for assembly fingerprints that no longer exist and fails to boot.
    The WebAssembly SDK defines these assets at their bin/wwwroot path but only copies them there after
    compression runs; the compressor sees the previous build's .gz as newer than the stale bin copy and
    keeps it. Refreshing the bin copies first makes compression see (and compress) the current files.
  -->
  <Target Name="_MauiWebRefreshComputedAssetsBeforeCompression" BeforeTargets="GenerateBuildCompressedStaticWebAssets"
          Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' == 'true' and '$(OutputType)' == 'Exe'">
    <ItemGroup>
      <_MauiWebComputedAsset Include="@(StaticWebAsset)" Condition="'%(SourceType)' == 'Computed' and '%(AssetKind)' != 'Publish' and '%(OriginalItemSpec)' != '' and Exists('%(OriginalItemSpec)')" />
      <_MauiWebStaleAsset Include="@(_MauiWebComputedAsset->'%(OriginalItemSpec)')" Condition="'$([System.IO.Path]::GetFullPath(%(OriginalItemSpec)))' != '%(Identity)'">
        <Destination>%(Identity)</Destination>
      </_MauiWebStaleAsset>
    </ItemGroup>
    <Copy SourceFiles="@(_MauiWebStaleAsset)" DestinationFiles="@(_MauiWebStaleAsset->'%(Destination)')" SkipUnchangedFiles="true" Condition="'@(_MauiWebStaleAsset)' != ''" />
  </Target>

</Project>
