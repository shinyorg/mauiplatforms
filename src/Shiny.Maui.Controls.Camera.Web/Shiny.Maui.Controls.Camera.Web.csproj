<!-- The Razor SDK is used only for its static web asset pipeline, which ships wwwroot/shiny-camera-web.js
     to consumers under _content/Shiny.Maui.Controls.Camera.Web/. No Razor components or Blazor are involved. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Maui.Controls.Camera.Web</RootNamespace>
        <PackageId>Shiny.Maui.Controls.Camera.Web</PackageId>
        <PackageVersion>$(WebPackageVersion)</PackageVersion>
        <!-- Not published to NuGet yet: built only as part of SampleWeb. -->
        <IsPackable>false</IsPackable>
        <Description>Browser backend for the Shiny .NET MAUI CameraView on Platform.Maui.Web, built on getUserMedia and MediaRecorder. Pairs with Shiny.Maui.Controls.Camera.</Description>
        <PackageTags>$(PackageTags) web wasm webassembly browser camera getusermedia</PackageTags>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsTrimmable>true</IsTrimmable>
        <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Shiny.Maui.Controls.Camera" Version="$(ShinyControlsVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Platform.Maui.Web\Platform.Maui.Web.csproj" />
    </ItemGroup>

    <!-- Same as Platform.Maui.Web: keep this library's dev-server manifests out of referencing apps. -->
    <Target Name="_MauiWebKeepDevManifestsOutOfReferencers" AfterTargets="AddStaticWebAssetEndpointsBuildManifest">
        <ItemGroup>
            <ContentWithTargetPath Remove="$(StaticWebAssetDevelopmentManifestPath);$(StaticWebAssetEndpointsBuildManifestPath)" />
        </ItemGroup>
    </Target>

</Project>
