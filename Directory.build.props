<Project>
    <PropertyGroup>
        <BaseTargetFramework>net10.0</BaseTargetFramework>
        <MauiVersion>10.0.120</MauiVersion>
        <ShinyControlsVersion>2.5.0-beta-0010</ShinyControlsVersion>
        <SkiaSharpVersion>4.151.1</SkiaSharpVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!--
            The tvOS and web packages share one version. NextVersion is the next release:
            - CI branch builds publish $(NextVersion)-preview.<run> (PreviewLabel)
            - pushing a tag vX.Y.Z publishes exactly X.Y.Z (ReleaseVersion, set by CI from the tag)
            - local builds are $(NextVersion)-dev, so they never look like a release
        -->
        <NextVersion>0.5.0</NextVersion>
        <PreviewLabel Condition="'$(PreviewLabel)' == ''">dev</PreviewLabel>
        <PlatformsPackageVersion Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</PlatformsPackageVersion>
        <PlatformsPackageVersion Condition="'$(ReleaseVersion)' == ''">$(NextVersion)-$(PreviewLabel)</PlatformsPackageVersion>
        <PackageVersion>$(PlatformsPackageVersion)</PackageVersion>
        <TvOSPackageVersion>$(PlatformsPackageVersion)</TvOSPackageVersion>
        <WebPackageVersion>$(PlatformsPackageVersion)</WebPackageVersion>
        <Description>MAUI Platforms</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Allan Ritchie</Copyright>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/shinyorg/mauiplatforms</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/shinyorg/mauiplatforms</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/shinyorg/mauiplatforms</RepositoryUrl>
        <PackageTags>shiny maui platforms essentials tvos web</PackageTags>
        <Authors>aritchie;redth</Authors>

        <CI Condition="'$(GITHUB_ACTIONS)' == 'true'">true</CI>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <IncludeSource>True</IncludeSource>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/nuget</PackageOutputPath>
        <PublishRepositoryUrl>True</PublishRepositoryUrl>
        <EmbedUntrackedSources>True</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)nuget.png" Pack="true" PackagePath="icon.png" />
        <None Include="$(MSBuildThisFileDirectory)readme.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>