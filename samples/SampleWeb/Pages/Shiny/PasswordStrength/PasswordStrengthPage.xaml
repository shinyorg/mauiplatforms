<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Features.PasswordStrength"
             xmlns:shiny="http://shiny.net/maui/controls"
             x:Class="Sample.Features.PasswordStrength.PasswordStrengthPage"
             x:DataType="local:PasswordStrengthViewModel"
             Title="Password Strength"
             AutomationId="PasswordStrengthPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="28">

            <Label AutomationId="PasswordStatusLabel" Text="{Binding Status}"
                   FontSize="13"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center" />

            <!-- The defaults: 15 characters, breached values refused, no composition rules -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Defaults (passphrase-first)" FontAttributes="Bold" />
                <Label Text="Fifteen characters, common passwords refused, and no &quot;must contain a symbol&quot; nonsense. Try &quot;Passw0rd!&quot; and then &quot;the slow red barn on nine&quot;."
                       FontSize="11"
                       TextColor="Gray" />

                <shiny:PasswordStrength x:Name="Passphrase"
                                        AutomationId="DefaultPasswordStrength"
                                        Variant="Floating"
                                        Placeholder="Passphrase"
                                        Password="{Binding Passphrase}"
                                        Score="{Binding PassphraseScore}"
                                        Level="{Binding PassphraseLevel}"
                                        IsAcceptable="{Binding IsPassphraseAcceptable}"
                                        StrengthChanged="OnStrengthChanged" />

                <!-- IsAcceptable, not Score: a long passphrase can still fail the policy -->
                <Button Text="Create account"
                        AutomationId="SubmitButton"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding IsPassphraseAcceptable}" />
            </VerticalStackLayout>

            <!-- What a legacy policy looks like when something external insists on one -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Legacy composition policy" FontAttributes="Bold" />
                <Label Text="Eight characters and one of everything — the shape of policy that produces &quot;Passw0rd!&quot;. Shown as a single bar rather than segments."
                       FontSize="11"
                       TextColor="Gray" />

                <shiny:PasswordStrength Placeholder="Password"
                                        Password="{Binding LegacyPassword}"
                                        IsAcceptable="{Binding IsLegacyAcceptable}"
                                        MinimumLength="8"
                                        RequireUppercase="True"
                                        RequireLowercase="True"
                                        RequireNumber="True"
                                        RequireSpecialCharacter="True"
                                        MeterStyle="Bar"
                                        MeterHeight="10"
                                        MeterCornerRadius="5" />
            </VerticalStackLayout>

            <!-- Resistance rather than composition: the policy is a time, not a character class -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Minimum time to crack" FontAttributes="Bold" />
                <Label Text="Must hold out for a century against ten billion guesses a second. &quot;abcdefghijklmnop&quot; clears the length rule but falls in moments; &quot;the slow red barn on nine&quot; passes."
                       FontSize="11"
                       TextColor="Gray" />

                <shiny:PasswordStrength Placeholder="Password"
                                        Password="{Binding CrackTimePassword}"
                                        IsAcceptable="{Binding IsCrackTimeAcceptable}"
                                        MinimumLength="8"
                                        MinimumTimeToCrack="36525.00:00:00"
                                        ShowTimeToCrack="True" />
            </VerticalStackLayout>

            <!-- Blocked list + the user's own details -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Blocked words and personal details" FontAttributes="Bold" />
                <Label Text="Refuses the house list (shiny, shinycontrols, letmein2026) and anything containing ada.lovelace@example.com or Ada Lovelace."
                       FontSize="11"
                       TextColor="Gray" />

                <shiny:PasswordStrength Placeholder="Password"
                                        Password="{Binding PersonalPassword}"
                                        BlockedPasswords="{Binding Blocked}"
                                        UserInputs="{Binding UserDetails}"
                                        MinimumLength="12" />
            </VerticalStackLayout>

            <!-- Pluggable scorer -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Custom evaluator" FontAttributes="Bold" />
                <Label Text="The same control with a deliberately slow IPasswordStrengthEvaluator standing in for an HIBP lookup. Typing fast shows the debounce and cancellation at work."
                       FontSize="11"
                       TextColor="Gray" />

                <shiny:PasswordStrength x:Name="Delayed"
                                        Placeholder="Checked against a slow service"
                                        DebounceMilliseconds="400"
                                        ShowRules="False" />
            </VerticalStackLayout>

            <!-- Wording -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Localized wording" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Switch x:Name="FrenchSwitch" Toggled="OnFrenchToggled" VerticalOptions="Center" />
                    <Label Text="Français" VerticalOptions="Center" FontSize="14" />
                </HorizontalStackLayout>

                <shiny:PasswordStrength x:Name="Localized"
                                        Placeholder="Mot de passe"
                                        MinimumLength="12"
                                        RequireNumber="True"
                                        ShowTimeToCrack="True" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
