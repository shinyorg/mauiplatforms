<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shiny="http://shiny.net/maui/controls"
    xmlns:local="clr-namespace:Sample.Features.TextEntry"
    x:Class="Sample.Features.TextEntry.TextEntryPage"
    x:DataType="local:TextEntryViewModel"
    Title="Text Entry"
    AutomationId="TextEntryPage">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="20">

            <!-- Basic (Classic, Bootstrap .form-control) -->
            <Label Text="Basic — Classic" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry AutomationId="FirstNameEntry" Placeholder="First Name"
                             Text="{Binding FirstName, Mode=TwoWay}" />

            <shiny:TextEntry AutomationId="LastNameEntry" Placeholder="Last Name"
                             Text="{Binding LastName, Mode=TwoWay}" />

            <!-- Floating (M3 notched outline) -->
            <Label Text="Floating Label — M3 notched outline" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry Placeholder="Email address" Variant="Floating"
                             Text="{Binding FloatingEmail, Mode=TwoWay}"
                             Keyboard="Email" />

            <shiny:TextEntry Placeholder="Password" Variant="Floating"
                             IsPassword="True"
                             Text="{Binding FloatingPassword, Mode=TwoWay}" />

            <!-- Floating with inline tools: the label notch shifts past the leading icon -->
            <shiny:TextEntry Placeholder="Search with a leading icon" Variant="Floating"
                             Text="{Binding FloatingSearch, Mode=TwoWay}">
                <shiny:TextEntry.LeftTools>
                    <shiny:TextEntryTool Text="🔍" />
                </shiny:TextEntry.LeftTools>
                <shiny:ClearButtonTool />
            </shiny:TextEntry>

            <!-- Autocomplete off -->
            <Label Text="No Autocomplete" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry Placeholder="Serial number"
                             Text="{Binding Serial, Mode=TwoWay}"
                             IsAutoCompleteEnabled="False"
                             HintText="Autofill, autocorrect, prediction and spell check are all off" />

            <!-- Keyboard accessory (iOS + Android) -->
            <Label Text="Keyboard Accessory" FontSize="18" FontAttributes="Bold" />
            <Label Text="Focus these and the bar docks to the top of the soft keyboard. iOS/Android only."
                   FontSize="12" TextColor="Gray" />

            <shiny:TextEntry Placeholder="Amount (numeric — no return key without a bar)"
                             Text="{Binding AccessoryAmount, Mode=TwoWay}"
                             Keyboard="Numeric"
                             AccessoryPreset="NavigationAndDone" />

            <shiny:TextEntry Placeholder="Quantity"
                             Text="{Binding AccessoryQuantity, Mode=TwoWay}"
                             Keyboard="Numeric"
                             AccessoryPreset="NavigationAndDone" />

            <!-- Custom accessory bar -->
            <shiny:TextEntry Placeholder="Notes (custom accessory)"
                             Text="{Binding AccessoryNotes, Mode=TwoWay}">
                <shiny:TextEntry.Accessory>
                    <shiny:KeyboardAccessoryView>
                        <shiny:KeyboardNavigationItem Direction="Previous" />
                        <shiny:KeyboardNavigationItem Direction="Next" />
                        <shiny:KeyboardAccessorySpacer />
                        <shiny:KeyboardAccessoryItem Text="#tag" Command="{Binding InsertTagCommand}" />
                        <shiny:KeyboardDismissItem />
                    </shiny:KeyboardAccessoryView>
                </shiny:TextEntry.Accessory>
            </shiny:TextEntry>

            <!-- Addon tool style (the old Bootstrap input-group look) -->
            <Label Text="Addon Tool Style (opt-in)" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry Placeholder="Amount"
                             Text="{Binding AddonAmount, Mode=TwoWay}"
                             ToolStyle="Addon"
                             Keyboard="Numeric">
                <shiny:TextEntry.LeftTools>
                    <shiny:TextEntryTool Text="$" />
                </shiny:TextEntry.LeftTools>
                <shiny:TextEntryTool Text=".00" />
            </shiny:TextEntry>

            <!-- With Clear Button -->
            <Label Text="With Clear Button" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry AutomationId="SearchEntry" Placeholder="Search"
                             Text="{Binding SearchText, Mode=TwoWay}">
                <shiny:ClearButtonTool AutomationId="SearchClear" />
            </shiny:TextEntry>

            <!-- Password -->
            <Label Text="Password" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry Placeholder="Password"
                             IsPassword="True"
                             Text="{Binding Password, Mode=TwoWay}">
                <shiny:ClearButtonTool />
            </shiny:TextEntry>

            <!-- Character Count -->
            <Label Text="Character Count" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry AutomationId="BioEntry" Placeholder="Bio (max 100)"
                             Text="{Binding Bio, Mode=TwoWay}"
                             MaxLength="100"
                             ShowCharacterCount="True" />

            <!-- Validation Error -->
            <Label Text="Validation" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry AutomationId="EmailEntry" Placeholder="Email"
                             Text="{Binding Email, Mode=TwoWay}"
                             Keyboard="Email"
                             HasError="{Binding HasEmailError}"
                             HintText="{Binding EmailError}">
                <shiny:ClearButtonTool />
            </shiny:TextEntry>

            <!-- Custom Styling -->
            <Label Text="Custom Styling" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry Placeholder="Purple theme"
                             Text="{Binding CustomText, Mode=TwoWay}"
                             FocusedBorderColor="#7C3AED"
                             FocusedPlaceholderColor="#7C3AED"
                             FocusedBorderThickness="2"
                             CornerRadius="16"
                             EntryBackgroundColor="#F5F3FF">
                <shiny:ClearButtonTool />
            </shiny:TextEntry>

            <!-- Read Only -->
            <Label Text="Read Only" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry AutomationId="ReadOnlyEntry" Placeholder="Read only"
                             Text="This field is read only"
                             IsReadOnly="True"
                             BorderColor="#E5E7EB"
                             EntryBackgroundColor="#F9FAFB" />

            <!-- Hint Text (no error) -->
            <Label Text="Hint Text" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry Placeholder="Phone Number"
                             Text="{Binding Phone, Mode=TwoWay}"
                             Keyboard="Telephone"
                             HintText="Include country code" />

            <!-- Numeric Keyboard -->
            <Label Text="Numeric" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry Placeholder="Amount"
                             Text="{Binding Amount, Mode=TwoWay}"
                             Keyboard="Numeric">
                <shiny:TextEntryTool Text="$" ToolColor="#059669" />
            </shiny:TextEntry>

            <!-- Masked Input -->
            <Label Text="Masked Input" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry AutomationId="MaskedPhoneEntry" Placeholder="Phone Number"
                             Mask="(###) ###-####"
                             Text="{Binding MaskedPhone, Mode=TwoWay}"
                             HintText="(555) 123-4567" />

            <shiny:TextEntry AutomationId="MaskedCardEntry" Placeholder="Credit Card"
                             Mask="#### #### #### ####"
                             Text="{Binding MaskedCard, Mode=TwoWay}"
                             HintText="1234 5678 9012 3456" />

            <shiny:TextEntry Placeholder="Date (MM/DD/YYYY)"
                             Mask="##/##/####"
                             Text="{Binding MaskedDate, Mode=TwoWay}" />

            <!-- Stepper Tool -->
            <Label Text="Stepper Tool" FontSize="18" FontAttributes="Bold" />
            <shiny:TextEntry AutomationId="QuantityEntry" Placeholder="Quantity"
                             Text="{Binding Quantity, Mode=TwoWay}"
                             Keyboard="Numeric">
                <shiny:TextEntry.LeftTools>
                    <shiny:TextEntryStepperTool AutomationId="QuantityDecrement" Step="-1" />
                </shiny:TextEntry.LeftTools>
                <shiny:TextEntryStepperTool AutomationId="QuantityIncrement" Step="1" />
            </shiny:TextEntry>

            <shiny:TextEntry Placeholder="Score"
                             Text="{Binding Score, Mode=TwoWay}"
                             Keyboard="Numeric">
                <shiny:TextEntry.LeftTools>
                    <shiny:TextEntryStepperTool Step="-5" />
                </shiny:TextEntry.LeftTools>
                <shiny:TextEntryStepperTool Step="5" />
            </shiny:TextEntry>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
