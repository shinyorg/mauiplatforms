<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>SampleWeb</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationId>org.shiny.web</ApplicationId>
        <ApplicationTitle>MAUI Web</ApplicationTitle>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <IsPackable>false</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Keep full exception messages in trimmed builds; remove to save a little download size. -->
        <UseSystemResourceKeys>false</UseSystemResourceKeys>
        <!-- AOT-compile to WebAssembly on publish (needs the wasm-tools workload). Debug/dotnet run
             still uses the interpreter; code AOT can't handle falls back to it at runtime. -->
        <RunAOTCompilation>true</RunAOTCompilation>
        <!-- Trimmed WebAssembly apps turn reflection-based System.Text.Json off by default (Blazor turns
             it back on). The agent demo's scripted session serializes anonymous event objects with it. -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <!-- The gallery pages (ported from the maui-labs GTK4 sample) use string-path bindings and
         QueryProperty, which need reflection; keep the sample's own members out of trimming. -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);IL2026</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <TrimmerRootAssembly Include="SampleWeb" />
        <!-- AGUI.Server's JSON options reach AGUI.Abstractions' interrupt content types by reflection;
             trimmed, every "Your key" run fails. The controls sample roots it for the same reason. -->
        <TrimmerRootAssembly Include="AGUI.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <!-- The agent page's "Recordings" source: AGUI.Server streams copied from the controls repo's tests. -->
        <EmbeddedResource Include="Pages\Shiny\Agents\AgentRecordings\*.sse" LogicalName="AgentRecordings/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- A Link names the image, as in MAUI's resizetizer: this is "app_logo.png" in the app. -->
        <MauiImage Include="Resources\AppIcon\appicon.svg" Link="Resources\Images\app_logo.svg" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Platform.Maui.Web\Platform.Maui.Web.csproj" />
        <ProjectReference Include="..\..\src\Platform.Maui.Essentials.Web\Platform.Maui.Essentials.Web.csproj" />
        <!-- SKCanvasView on the web; links Skia into dotnet.native.wasm (needs the wasm-tools workload). -->
        <ProjectReference Include="..\..\src\Platform.Maui.Web.SkiaSharp\Platform.Maui.Web.SkiaSharp.csproj" />
        <!-- Shiny Controls tab: web backends for CameraView and MediaElement (they bring in the Shiny
             Camera and MediaElement packages), plus the core Shiny controls package. -->
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Camera.Web\Shiny.Maui.Controls.Camera.Web.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.MediaElement.Web\Shiny.Maui.Controls.MediaElement.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Shiny.Maui.Controls" Version="$(ShinyControlsVersion)" />
        <!-- Spreadsheet, document, slide and notebook editors, drawn on SKCanvasView (Platform.Maui.Web.SkiaSharp). -->
        <PackageReference Include="Shiny.Maui.Controls.Office" Version="$(ShinyControlsVersion)" />
        <PackageReference Include="Shiny.Maui.Controls.Diagram" Version="$(ShinyControlsVersion)" />
        <PackageReference Include="Shiny.Maui.Controls.MermaidDiagrams" Version="$(ShinyControlsVersion)" />
        <PackageReference Include="Shiny.Maui.Controls.Keyframe" Version="$(ShinyControlsVersion)" />
        <!-- AgentView and A2UISurfaceView (AG-UI / A2UI), and the Visual-Studio-style DockHostView. -->
        <PackageReference Include="Shiny.Maui.Controls.Agents" Version="$(ShinyControlsVersion)" />
        <PackageReference Include="Shiny.Maui.Controls.Desktop" Version="$(ShinyControlsVersion)" />
        <!-- The agent page's "Endpoint" and "Your key" sources: an AG-UI HTTP client, and AGUI.Server
             in-process over an OpenAI-compatible IChatClient, as the controls sample uses them. -->
        <PackageReference Include="AGUI.Client" Version="1.0.1" />
        <PackageReference Include="AGUI.Server" Version="1.0.1" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.1" />
        <!-- The Shiny pages are copied from the controls sample, whose view models use the MVVM toolkit. -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <!-- Package consumers get this from the package's build/ folder; a project reference must import it. -->
    <Import Project="..\..\src\Platform.Maui.Web\buildTransitive\Platform.Maui.Web.targets" />

</Project>
