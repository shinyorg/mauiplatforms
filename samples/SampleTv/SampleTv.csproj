<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-tvos</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>

        <ApplicationTitle>MAUI tvOS</ApplicationTitle>
        <ApplicationId>org.shiny.tvos</ApplicationId>
        <ApplicationIdGuid>C5E91D2A-367B-4F8C-A1D3-8B4F22E5D691</ApplicationIdGuid>

        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <DefineConstants>$(DefineConstants);TVAPP</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <ProjectReference Include="..\..\src\Platform.Maui.TvOS\Platform.Maui.TvOS.csproj" />
        <ProjectReference Include="..\..\src\Platform.Maui.Essentials.TvOS\Platform.Maui.Essentials.TvOS.csproj" />
    </ItemGroup>

    <!-- The pages live in this project; only the tvOS entry point is shared with samples/Sample. -->
    <ItemGroup>
        <Compile Include="..\Sample\Platforms\tvOS\Main.cs">
            <Link>Main.cs</Link>
        </Compile>
        <Compile Include="..\Sample\Platforms\tvOS\MauiTvOSApp.cs">
            <Link>MauiTvOSApp.cs</Link>
        </Compile>
        <BundleResource Include="..\Sample\Platforms\tvOS\Info.plist">
            <Link>Info.plist</Link>
        </BundleResource>
    </ItemGroup>

</Project>
